# ============================================================
# CCMS — Orient Paper & Mill  |  Environment Configuration
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
# LOCAL DEV — use the discrete vars below.
#   Create the database once:  createdb -U postgres ccms
#   Then seed everything:       npm run init-db          (schema + seed)
PGHOST=localhost
PGPORT=5432
PGDATABASE=ccms
PGUSER=postgres
PGPASSWORD=your_postgres_password
PG_POOL_MAX=10

# HOSTED / PaaS — set a single connection string instead of the PG* vars above
# (Render, Neon, Railway, Heroku, Supabase, RDS, …). When DATABASE_URL is set,
# it wins, TLS is enabled automatically, and `npm run init-db` uses the managed
# database as-is (it will NOT try to CREATE DATABASE).
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# TLS controls (usually unnecessary — sensible defaults are applied):
#   PGSSL=true|false                 force SSL on/off for the PG* path
#   PGSSLMODE=require|disable        alternative way to force/disable SSL
#   PGSSL_REJECT_UNAUTHORIZED=true   verify the server cert (default: false, which
#                                    accepts the self-signed chains most PaaS use)
#   PGSSLROOTCERT=/path/to/ca.pem    CA bundle to verify against (with the above)
# PGSSL=true

# ─────────────────────────────────────────────────────────────
# SAP S/4HANA Integration
# ─────────────────────────────────────────────────────────────
# Set SAP_USE_MOCK=false when real SAP credentials are available.
# No other code changes are required — only these 5 lines.
SAP_USE_MOCK=true

SAP_BASE_URL=https://your-sap-host:port/sap/opu/odata/sap
SAP_USERNAME=your_service_account
SAP_PASSWORD=your_service_password
# SAP client (mandant) sent as the sap-client header on real calls. Default 100.
SAP_CLIENT=100

# Standard SAP OData service paths (confirm exact paths with SAP functional team)
SAP_BILLING_SERVICE=API_BILLING_DOCUMENT_SRV
SAP_BUSINESS_PARTNER_SERVICE=API_BUSINESS_PARTNER
SAP_PRODUCT_SERVICE=API_PRODUCT_SRV
SAP_CREDIT_MEMO_SERVICE=API_SALES_ORDER_SRV
SAP_PRICING_SERVICE=API_SLSPRICINGCONDITIONRECORD_SRV

# ─────────────────────────────────────────────────────────────
# Business Rules (configurable — do NOT hard-code in source)
# ─────────────────────────────────────────────────────────────
# Settlement above this amount triggers MD Approval (Section 8.1)
MD_APPROVAL_THRESHOLD=100000

# Settlement above this amount triggers mandatory Customer Visit (Section 7.2)
VISIT_THRESHOLD=50000

# Days before a Sample Awaited complaint is auto-escalated (Section 12.2)
SAMPLE_SLA_DAYS=7

# Days before any stage auto-escalates to supervisor (Section 12.2)
STAGE_SLA_DAYS=3

# Complaint window (days from invoice date) after which complaint is policy-flagged (Section 9)
DEFAULT_COMPLAINT_WINDOW_DAYS=30

# ── JWT Authentication (Section 12.3 — RBAC) ──────────────────────────────
# REQUIRED. Anyone holding this value can forge a token for any user or role,
# so it must be random, secret, and never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server warns on a weak secret in dev and refuses to boot in production.
JWT_SECRET=
JWT_EXPIRES=8h

# The JWT is delivered as an httpOnly cookie, so page JavaScript can never
# read it. Defaults suit local dev; for production see below.
#   CORS_ORIGIN      — comma-separated allow-list of frontend origins. Required
#                      with cookie auth: the wildcard is illegal, and any listed
#                      origin can make authenticated requests.
#   COOKIE_SAMESITE  — 'lax' is right when the frontend and API share a site.
#                      Only use 'none' if they're on different domains — it
#                      needs HTTPS and weakens CSRF protection.
#   TRUST_PROXY      — 'true' when running behind Nginx/Heroku/Render so
#                      req.secure is accurate and Secure cookies work.
# In production (NODE_ENV=production) the cookie is Secure, HSTS is sent, and
# the API refuses plain HTTP.
CORS_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=lax
TRUST_PROXY=false

# ── Notifications (Section 12.1 — Communication Matrix) ───────────────────
# NOTIFY_MODE=mock  → logs to console + /api/notifications (no real emails)
# NOTIFY_MODE=live  → sends real emails via SMTP
NOTIFY_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
# For Gmail: use an App Password (myaccount.google.com → Security → App Passwords)
SMTP_PASS=your-app-password
SMTP_FROM=ccms-noreply@orientpaper.com

# ── SLA Engine (Section 12.2 — Auto-Escalation) ───────────────────────────
SLA_ENABLED=true
# How often the SLA engine checks complaints (minutes). Use 1 for demo.
SLA_TICK_MINUTES=60
# Days before a stage auto-escalates to supervisor
STAGE_SLA_DAYS=3
# Days before Sample_Awaited auto-escalates
SAMPLE_SLA_DAYS=7
# Days before Clarification_Sought auto-closes
CLARIFY_SLA_DAYS=30

# ── Security / Rate Limiting (Section 12.6) ───────────────────────────────
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
# Largest page size a client may request on paginated list endpoints.
MAX_PAGE_SIZE=200
# Body-size cap for JSON requests.
JSON_BODY_LIMIT=1mb
# Set DB_LOG=true (with NODE_ENV=development) to log DB query timings.
# DB_LOG=false

# ── Data Retention & Archival (Section 12.7) ──────────────────────────────
ARCHIVE_ENABLED=true
ATTACHMENT_RETENTION_DAYS=365
COMPLAINT_ARCHIVE_DAYS=730
ARCHIVE_TICK_HOURS=24

# ── Attachment uploads ────────────────────────────────────────────────────
# Uploaded files are stored on local disk (metadata stays in the DB). Point
# UPLOAD_DIR at durable storage in production; default is backend/uploads.
# UPLOAD_DIR=/var/lib/ccms/uploads
UPLOAD_MAX_BYTES=5242880

# ── KPI dashboard cache ───────────────────────────────────────────────────
# Per-user cache TTL (ms) for GET /api/kpi. 0 disables (always live).
KPI_CACHE_MS=10000

# ── Phased Rollout (Section 12.8) ─────────────────────────────────────────
# Complaint creation is gated on this: a business line or region the phase
# does not cover is rejected with a 403.
# 1 = Pilot (Paper / North India only) — of the seeded customers only
#     Himalaya Paper Mart (1000789) can file; the rest are rejected by design
# 2 = Extended (Paper all regions + Chemical North India)
# 3 = Full rollout (all business lines + regions)
# Ships as 3 so a fresh clone can file against any seeded customer. Drop to 1
# to exercise the pilot gate.
ROLLOUT_PHASE=3
